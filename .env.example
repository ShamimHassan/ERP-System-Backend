NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_sales?schema=public"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Rate limiting (optional — these are the defaults)
# RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
# RATE_LIMIT_AUTH_MAX=10        # max login/refresh attempts per window per IP
# RATE_LIMIT_API_MAX=500        # max general API requests per window per IP
