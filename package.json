{
  "name": "erp-system-backend",
  "version": "1.0.0",
  "description": "Develop a functional **Sales & Marketing Management Module** for an ERP system. The purpose of this task is to evaluate the ability to understand business requirements, design a scalable database, implement role-based access control, build APIs, develop a professional ERP interface, and manage a complete sales lifecycle.",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsup src/server.ts --format cjs --out-dir dist",
    "start": "node dist/server.js",
    "seed": "npx prisma db seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShamimHassan/ERP-System-Backend.git"
  },
